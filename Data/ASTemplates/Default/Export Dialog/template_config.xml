<?xml version="1.0" encoding="utf-8"?>
<Template>
	<Keywords>
		<!-- This template has no keywords -->
	</Keywords>

	<Instructions>		
	
		<Instruction Type="Check">
			<Destinations>
				<Destination>$PROJECT_PATH\Logical\mappView\Layouts</Destination>
				<Destination>$PROJECT_PATH\Logical\mappView\Layouts</Destination>
				<Destination>$PROJECT_PATH\Logical\mappView\Layouts</Destination>
			</Destinations>
		</Instruction>

		<!-- Logical view - mappView - layout -->
		<Instruction Type="Copy">
			<Sources>
				<Source Type="File">$TEMPLATE_PATH\LogicalView\mappView\Layouts\USBExport.layout</Source>
			</Sources>
			<Destinations>
				<Destination>$PROJECT_PATH\Logical\mappView\Layouts</Destination>
			</Destinations>
		</Instruction>
		
		<!-- Logical view - mappView - dialog -->
		<Instruction Type="Copy">
			<Sources>
				<Source Type="Package">$TEMPLATE_PATH\LogicalView\mappView\Dialogs\USBExport</Source>
			</Sources>
			<Destinations>
				<Destination>$PROJECT_PATH\Logical\mappView\$SEARCH_FUNCTION(VisualizationPackage)\Dialogs</Destination>
			</Destinations>
		</Instruction>
		
		<!-- Logical view - mappView - media -->
		<Instruction Type="Copy">
			<Sources>
				<Source Type="Package">$TEMPLATE_PATH\LogicalView\mappView\Media\USBExport</Source>
			</Sources>
			<Destinations>
				<Destination>$PROJECT_PATH\Logical\mappView\Resources\Media</Destination>
			</Destinations>
		</Instruction>
		
		<!-- Logical view - programs -->
		<Instruction Type="Copy">
			<Sources>
				<Source Type="Package">$TEMPLATE_PATH\LogicalView\USBExport</Source>
			</Sources>
			<Destinations>
				<Destination>$PROJECT_PATH\Logical</Destination>
			</Destinations>
		</Instruction>
		
		<!-- Configuration view - opcua file -->
		<Instruction Type="Copy">
			<Sources>
				<Source Type="File">$TEMPLATE_PATH\ConfigurationView\OPCUA\USBExport.uad</Source>
			</Sources>
			<Destinations>
				<Destination>$ACTIVE_CONFIGURATION_PATH\Connectivity\OpcUA</Destination>	
			</Destinations>		
		</Instruction>
		
		<!-- Configuration view - bindings -->
		<Instruction Type="Copy">
			<Sources>
				<Source Type="Package">$TEMPLATE_PATH\ConfigurationView\mappView\USBExport</Source>
			</Sources>
			<Destinations>
				<Destination>$ACTIVE_CONFIGURATION_PATH\mappView</Destination>
			</Destinations>		
		</Instruction>
		
		<!-- Configuration view - visualization file bindings -->
		<Instruction Type="AddXmlElement" ErrorAction="Continue">
			<XmlElementsGroups>
				<XmlElementsGroup Path="/Visualization/BindingsSets">
					<BindingsSet refId="usb_export_content_binding" />
				</XmlElementsGroup>
				<XmlElementsGroup Path="/Visualization/EventBindingsSets">
					<EventBindingsSet refId="usb_export_content_eventbinding" />
				</XmlElementsGroup>
				<XmlElementsGroup Path="/Visualization/Dialogs">
					<Dialog refId="usb_export_dialog" />
				</XmlElementsGroup>
				<XmlElementsGroup Path="/Visualization/Contents">
					<Content refId="usb_export_content" />
				</XmlElementsGroup>
			</XmlElementsGroups>

			<Destinations>
				<Destination>$ACTIVE_CONFIGURATION_PATH\mappView\$SEARCH_FUNCTION(VisualizationFile)</Destination>
			</Destinations>		
		</Instruction>

		<!-- Dependencies -->
		<Instruction Type="Copy" ErrorAction="Ignore">
			<Sources>
				<Source Type="Library_binary">$TEMPLATE_PATH\Dependencies\AsArSdm</Source>
				<Source Type="Library_binary">$TEMPLATE_PATH\Dependencies\asstring</Source>
				<Source Type="Library_binary">$TEMPLATE_PATH\Dependencies\AsUSB</Source>
				<Source Type="Library_binary">$TEMPLATE_PATH\Dependencies\FileIO</Source>
				<Source Type="Library_binary">$TEMPLATE_PATH\Dependencies\standard</Source>
			</Sources>
			<Destinations>
				<Destination>$ACTIVE_CONFIGURATION_PATH\Logical\Libraries</Destination>
			</Destinations>		
		</Instruction>

	</Instructions>

	<SearchFunctions>
		<SearchFunction ID="VisualizationPackage">
			<TargetType>Package</TargetType>
			<TargetInnerFile>Package.pkg</TargetInnerFile>
			<TargetInnerFileInnerText>VisualizationPackage</TargetInnerFileInnerText>
		</SearchFunction>
					
		<SearchFunction ID="VisualizationFile">
			<TargetType>File</TargetType>
			<TargetExtension>.vis</TargetExtension>
		</SearchFunction>
				
		<SearchFunction ID="TextConfigurationFile">
			<TargetType>File</TargetType>
			<TargetExtension>.textconfig</TargetExtension>
		</SearchFunction>				
	</SearchFunctions>

</Template>